{
  "name": "meu-app-electron",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item dist\\* -Recurse -Force } ; if (Test-Path build) { Remove-Item build\\* -Recurse -Force }\"", 
    "start": "electron .",
    "build": "npm run clean && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "electron": "^35.0.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.Komercio-app.electron",
    "productName": "Komercio-app",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "Komercio-theme.css",
      "assets/icon/sound",
      "renderer.js",
      "storage.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "select2": "^4.1.0-rc.0"
  }
}
